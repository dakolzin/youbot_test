    <!-- friction - N, N*m -->
    <limit effort="10000.0" lower="0" upper="5.89920788889" velocity="1.570795"/>
    <!--effort - N, N*m-->
    <!--velocity - m/s, rad/s-->
    <!--k_position N/m, N/rad-->
    <!--k_velocity N*s/m, N*s*m/rad-->
    <!--for details: http://www.ros.org/wiki/pr2_controller_manager/safety_limits-->
  </joint>
