    <parent link="arm_link_0"/>
    <child link="arm_link_1"/>
    <axis xyz="0 0 -1"/>
    <!--<calibration rising="${arm_1_ref}" falling="${arm_1_ref}"/>-->
    <dynamics damping="1" friction="1"/>
